# Amazon SP-API OAuth Credentials
# Get these from Amazon Seller Central > Apps & Services > Develop Apps

# LWA (Login with Amazon) Credentials
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LWA_CLIENT_SECRET=your-client-secret-here

# Your SP-API App ID (from Developer Central)
SP_API_APP_ID=amzn1.sp.solution.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# IAM Role ARN (for SP-API access)
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-sp-api-role

# Application Settings
APP_SECRET_KEY=your-random-secret-key-change-this-in-production
APP_BASE_URL=http://localhost:8000

# OAuth Redirect URI (must match what's configured in your Amazon App)
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Default Marketplace (US, CA, UK, etc.)
DEFAULT_MARKETPLACE=US
